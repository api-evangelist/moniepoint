        },
        {
          "info": {
            "name": "Monnify List Refunds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pos.moniepoint.com/api/v1/refunds",
            "params": [
              {
                "name": "pageNo",
