              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Monnify List Refunds"
        },
        {
          "info": {
            "name": "Monnify Get Refund Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pos.moniepoint.com/api/v1/refunds/:refundReference",
