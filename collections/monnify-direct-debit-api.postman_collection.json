  "info": {
    "_postman_id": "2bfd1448-8c93-4032-94b2-d83d1bad411f",
    "name": "Monnify Direct Debit API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Create, activate, and debit recurring NIBSS direct-debit mandates against a customer's bank account. Smart routing introduced in September 2025 uses TeamApt as the primary processor with NIBSS as fallback. As of April 2026 the debit endpoint accepts an incomeSplit object to settle a debited amount across multiple sub-accounts.\n\n\nContact Support:\n Name: Monnify Developer Support",
      "type": "text/plain"
    }
  }
