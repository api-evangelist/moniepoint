{
  "item": [
    {
      "id": "58b5139e-4e80-43ca-9ee8-93b6c99f17b8",
      "name": "Authentication",
      "description": {
        "content": "Obtain a Bearer access token for the Monnify API.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "95c94f87-715b-4bab-b02f-d8837ac9bcbe",
          "name": "Monnify Log In And Issue Access Token",
          "request": {
            "name": "Monnify Log In And Issue Access Token",
            "description": {
              "content": "Authenticate with Basic auth using your API key as the username and your secret key as the password. Returns an OAuth-style accessToken and expiresIn (seconds). Cache the token until expiry to avoid re-authenticating on every call.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "fef452e5-d819-4da8-b803-4edb10e95e4e",
              "name": "Access token issued successfully.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "login"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"requestSuccessful\": true,\n  \"responseMessage\": \"success\",\n  \"responseCode\": \"0\",\n  \"responseBody\": {\n    \"accessToken\": \"eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJNS19QUk9EXzAxIn0.x\",\n    \"expiresIn\": 3600\n  }\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
            {
              "id": "098a83a8-6005-4663-a72e-ae8ca3cd0830",
              "name": "Authentication failed.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "login"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"requestSuccessful\": false,\n  \"responseMessage\": \"string\",\n  \"responseCode\": \"string\",\n  \"responseBody\": {}\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://api.monnify.com",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{basicAuthUsername}}"
      },
      {
        "key": "password",
        "value": "{{basicAuthPassword}}"
      }
    ]
  },
  "info": {
    "_postman_id": "18ac50cb-5e27-49fe-8d56-eb5a747f535e",
    "name": "Monnify Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Exchange Monnify API key and secret credentials for a short-lived Bearer access token. Every other Monnify endpoint requires the access token returned by POST /api/v1/auth/login as Authorization: Bearer {accessToken}. Tokens expire after one hour and must be re-issued.\n\n\nContact Support:\n Name: Monnify Developer Support",
      "type": "text/plain"
    }
  }
}